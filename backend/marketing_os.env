# Environment
NODE_ENV=production
PORT=8000

# Database (PostgreSQL inside Docker)
# Since the app runs on the host (EC2) and DB is in Docker with ports mapped:
DATABASE_URL=postgresql://edger_user:edger_pass@localhost:5436/travel_ops
POSTGRES_URL=postgresql://edger_user:edger_pass@localhost:5436/travel_ops
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20 # Increased for production

# JWT
# IMPORTANT: Change this to a strong, random string in production!
# You can generate one using: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY
JWT_EXPIRES_IN=7d

# Tenant
DEFAULT_TENANT_SLUG=default

# CORS
# IMPORTANT: Change this to your actual production frontend domain!
# Example: CORS_ORIGIN=https://app.marketing-os.com
CORS_ORIGIN=http://YOUR_EC2_IP_OR_DOMAIN

# Redis (Inside Docker)
REDIS_HOST=localhost
REDIS_PORT=6378

# MongoDB (Inside Docker)
MONGO_URI=mongodb://localhost:27018/marketing-os?directConnection=true
