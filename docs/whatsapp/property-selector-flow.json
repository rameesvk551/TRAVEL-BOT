{
  "version": "7.2",
  "data_api_version": "3.0",
  "routing_model": {
    "PROPERTY_FILTER": ["PROPERTY_SELECTOR"],
    "PROPERTY_SELECTOR": []
  },
  "screens": [
    {
      "id": "PROPERTY_FILTER",
      "title": "Find a Stay",
      "data": {
        "property_locations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "ALL", "title": "All locations" },
            { "id": "Goa", "title": "Goa" },
            { "id": "Munnar", "title": "Munnar" }
          ]
        },
        "property_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "metadata": { "type": "string" },
              "image": { "type": "string" }
            }
          },
          "__example__": [
            {
              "id": "prop_goa_villa_01",
              "title": "Goa Beach Villa",
              "description": "INR 18,999/night - 3BR private stay with pool, breakfast, and beach access.",
              "metadata": "Villa - Goa",
              "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+yh8cAAAAASUVORK5CYII="
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "property_filter_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Find Your Stay"
              },
              {
                "type": "TextBody",
                "text": "Share your stay details to see matching properties."
              },
              {
                "type": "Dropdown",
                "label": "Location",
                "name": "propertyLocation",
                "data-source": "${data.property_locations}",
                "required": true
              },
              {
                "type": "TextInput",
                "label": "Check-in Date",
                "name": "checkInDate",
                "required": true,
                "input-type": "text",
                "helper-text": "Example: 20 May 2026"
              },
              {
                "type": "TextInput",
                "label": "Check-out Date",
                "name": "checkOutDate",
                "required": true,
                "input-type": "text",
                "helper-text": "Example: 23 May 2026"
              },
              {
                "type": "TextInput",
                "label": "Guests",
                "name": "guests",
                "required": true,
                "input-type": "number",
                "helper-text": "Total guests"
              },
              {
                "type": "Footer",
                "label": "Search Stays",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "propertyLocation": "${form.propertyLocation}",
                    "checkInDate": "${form.checkInDate}",
                    "checkOutDate": "${form.checkOutDate}",
                    "guests": "${form.guests}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PROPERTY_SELECTOR",
      "title": "Choose Property",
      "terminal": true,
      "data": {
        "propertyLocation": {
          "type": "string",
          "__example__": "Goa"
        },
        "checkInDate": {
          "type": "string",
          "__example__": "20 May 2026"
        },
        "checkOutDate": {
          "type": "string",
          "__example__": "23 May 2026"
        },
        "guests": {
          "type": "string",
          "__example__": "2"
        },
        "property_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "metadata": { "type": "string" },
              "image": { "type": "string" }
            }
          },
          "__example__": [
            {
              "id": "prop_goa_villa_01",
              "title": "Goa Beach Villa",
              "description": "INR 18,999/night - 3BR private stay with pool, breakfast, and beach access.",
              "metadata": "Villa - Goa",
              "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+yh8cAAAAASUVORK5CYII="
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "property_selector_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Matching Properties"
              },
              {
                "type": "TextBody",
                "text": "${data.propertyLocation} stay options for ${data.guests} guest(s)."
              },
              {
                "type": "RadioButtonsGroup",
                "label": "Available Properties",
                "name": "propertyId",
                "data-source": "${data.property_options}",
                "media-size": "large",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Request Availability",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "propertyId": "${form.propertyId}",
                    "propertyLocation": "${data.propertyLocation}",
                    "checkInDate": "${data.checkInDate}",
                    "checkOutDate": "${data.checkOutDate}",
                    "guests": "${data.guests}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
