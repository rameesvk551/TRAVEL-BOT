{
  "version": "7.2",
  "data_api_version": "3.0",
  "routing_model": {
    "CUSTOM_TRIP_FORM": []
  },
  "screens": [
    {
      "id": "CUSTOM_TRIP_FORM",
      "title": "Custom Trip",
      "terminal": true,
      "data": {
        "campaign_name": {
          "type": "string",
          "__example__": "ABC Holiday Campaign"
        },
        "customer_name": {
          "type": "string",
          "__example__": "Rahul Sharma"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "custom_trip_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Plan Your Custom Trip"
              },
              {
                "type": "TextBody",
                "text": "Share your trip preferences and our team will build a package around your dates, budget, and travel style."
              },
              {
                "type": "TextInput",
                "label": "Full Name",
                "name": "name",
                "required": true,
                "input-type": "text",
                "helper-text": "Enter your full name"
              },
              {
                "type": "TextInput",
                "label": "Destination or Route",
                "name": "destination",
                "required": true,
                "input-type": "text",
                "helper-text": "Example: Bali, Goa, Dubai, Kerala, Europe"
              },
              {
                "type": "TextInput",
                "label": "Travel Date or Month",
                "name": "travelDate",
                "required": true,
                "input-type": "text",
                "helper-text": "Example: 20 May 2026 or June 2026"
              },
              {
                "type": "TextInput",
                "label": "Travellers",
                "name": "travellers",
                "required": true,
                "input-type": "number",
                "helper-text": "Total travellers (1 to 50)"
              },
              {
                "type": "TextInput",
                "label": "Budget per Person",
                "name": "budget",
                "required": true,
                "input-type": "number",
                "helper-text": "Approximate budget per person in rupees"
              },
              {
                "type": "TextInput",
                "label": "Trip Notes (Optional)",
                "name": "notes",
                "required": false,
                "input-type": "text",
                "helper-text": "Honeymoon, family, villa, flight preference, sightseeing, etc."
              },
              {
                "type": "Footer",
                "label": "Submit Request",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "name": "${form.name}",
                    "destination": "${form.destination}",
                    "travelDate": "${form.travelDate}",
                    "travellers": "${form.travellers}",
                    "budget": "${form.budget}",
                    "notes": "${form.notes}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
