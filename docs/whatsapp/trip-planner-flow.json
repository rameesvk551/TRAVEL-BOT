{
  "version": "7.2",
  "data_api_version": "3.0",
  "routing_model": {
    "PACKAGE_SELECTOR": ["ENQUIRY_FORM"],
    "ENQUIRY_FORM": []
  },
  "screens": [
    {
      "id": "PACKAGE_SELECTOR",
      "title": "Choose Package",
      "terminal": true,
      "data": {
        "category_label": {
          "type": "string",
          "__example__": "Domestic"
        },
        "package_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "metadata": { "type": "string" },
              "image": { "type": "string" }
            }
          },
          "__example__": [
            {
              "id": "pkg_goa_01",
              "title": "Goa Bliss Escape",
              "description": "₹24,999 • 3 Nights 4 Days\nBeach stay, breakfast, transfers, and sunset cruise.",
              "metadata": "Domestic",
              "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+yh8cAAAAASUVORK5CYII="
            },
            {
              "id": "pkg_bali_01",
              "title": "Bali Romance",
              "description": "₹68,999 • 5 Nights 6 Days\nResort stay, island tours, and curated couple moments.",
              "metadata": "International",
              "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+yh8cAAAAASUVORK5CYII="
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "package_selector_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.category_label} Packages"
              },
              {
                "type": "TextBody",
                "text": "Choose one package to view details or start enquiry."
              },
              {
                "type": "RadioButtonsGroup",
                "label": "Available Packages",
                "name": "packageId",
                "description": "Each card shows image, price, duration, and a short summary.",
                "data-source": "${data.package_options}",
                "media-size": "large",
                "required": true
              },
              {
                "type": "Footer",
                "label": "View Package",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "packageId": "${form.packageId}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
    ,
    {
      "id": "ENQUIRY_FORM",
      "title": "Package Enquiry",
      "terminal": true,
      "data": {
        "package_id": {
          "type": "string",
          "__example__": "pkg_goa_01"
        },
        "package_name": {
          "type": "string",
          "__example__": "Goa Bliss Escape"
        },
        "package_summary": {
          "type": "string",
          "__example__": "INR 24,999 • 3 Nights 4 Days"
        },
        "customer_name": {
          "type": "string",
          "__example__": "Rahul Sharma"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "enquiry_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.package_name}"
              },
              {
                "type": "TextBody",
                "text": "${data.package_summary}"
              },
              {
                "type": "TextInput",
                "label": "Full Name",
                "name": "name",
                "required": true,
                "input-type": "text",
                "helper-text": "Enter your full name"
              },
              {
                "type": "TextInput",
                "label": "Travel Date or Month",
                "name": "travelDate",
                "required": true,
                "input-type": "text",
                "helper-text": "Example: 20 May 2026 or June 2026"
              },
              {
                "type": "TextInput",
                "label": "Travellers",
                "name": "travellers",
                "required": true,
                "input-type": "number",
                "helper-text": "Total travellers (1 to 50)"
              },
              {
                "type": "TextInput",
                "label": "Budget per Person",
                "name": "budget",
                "required": true,
                "input-type": "number",
                "helper-text": "Approximate budget per person in rupees"
              },
              {
                "type": "TextInput",
                "label": "Other Details (Optional)",
                "name": "notes",
                "required": false,
                "input-type": "text",
                "helper-text": "Honeymoon, family, hotel preference, etc."
              },
              {
                "type": "Footer",
                "label": "Submit Enquiry",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "packageId": "${data.package_id}",
                    "name": "${form.name}",
                    "travelDate": "${form.travelDate}",
                    "travellers": "${form.travellers}",
                    "budget": "${form.budget}",
                    "notes": "${form.notes}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
