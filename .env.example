# ==========================================
# TravelBot — Environment Variables
# ==========================================
# Copy this file to .env and fill in real values

# App
NODE_ENV=development
PORT=3000
BOT_PORT=3001
BASE_URL=https://yourdomain.com
PUBLIC_API_BASE_URL=https://yourdomain.com
ADMIN_APP_HOST=travelbot.yourdomain.com
PUBLIC_SITE_ROOT_DOMAIN=sites.yourdomain.com
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
ENCRYPTION_KEY=your_32_byte_hex_key_for_razorpay_secret_encryption

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/travelbot
DB_HOST=localhost
DB_PORT=5432
DB_NAME=travelbot
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379

# WhatsApp / Marketing OS
WEBHOOK_VERIFY_TOKEN=your_meta_webhook_verify_token
WEBHOOK_APP_SECRET=your_meta_app_secret_for_signature_verification
MARKETING_OS_PARTNER_API_BASE_URL=http://127.0.0.1:8000/api/v1
MARKETING_OS_PARTNER_API_KEY=your_marketing_os_partner_api_key
MARKETING_OS_WEBHOOK_SECRET=your_marketing_os_webhook_secret
WHATSAPP_CLOUD_API_TOKEN=your_meta_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_TRIP_FLOW_ID=your_meta_trip_flow_id
WHATSAPP_TRIP_ENQUIRY_FLOW_ID=your_meta_enquiry_flow_id
WHATSAPP_TRIP_FLOW_FIRST_SCREEN_ID=TRIP_PLANNER
WHATSAPP_TRIP_FLOW_CTA=Plan Trip
INTERAKT_API_KEY=your_interakt_api_key
INTERAKT_BASE_URL=https://api.interakt.ai/v1/public

# Twilio voice bridge
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_VALIDATE_WEBHOOKS=true
CALL_RECORDING_ENABLED=true

# Cloudinary (backend uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=travel-bot/packages

# Frontend
VITE_API_BASE_URL=http://localhost:3000/api
VITE_INSTAGRAM_APP_ID=your_instagram_login_app_id
